# API-only secrets. Copy to .env.api.
# docker compose run --rm api rack hash-password   -> paste inside single quotes
# Creates the owner account on the first login (v2.1); afterwards change the password in the app
# or with `rack reset-password <username>` (editing this hash then does nothing).
RACK_PASSWORD_HASH=
# The owner's username (3-24 of a-z 0-9 _ .), also only read when the owner account is created.
RACK_OWNER_USERNAME=owner
# python -c "import secrets;print(secrets.token_urlsafe(48))"   (at least 32 characters)
RACK_SESSION_SECRET=
