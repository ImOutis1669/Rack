# Shared settings for every container. Secrets live in separate files so each container only
# gets what it needs (copy the matching .example files):
#   .env.api     password hash, session secret          (api)
#   .env.worker  eBay, Grailed, Anthropic keys            (worker)
#   .env.tunnel  Cloudflare Tunnel token                  (cloudflared)
# --- Core ---
DATABASE_URL=postgresql+asyncpg://rack:rack@db:5432/rack
POSTGRES_USER=rack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rack

# --- Auth (app is public via tunnel) ---
# Generate with: docker compose run --rm api rack hash-password
# Long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
RACK_PUBLIC_URL=https://rack.example.com

# --- eBay Browse API (developer.ebay.com, production keyset) ---
EBAY_MARKETPLACE=EBAY_GB
# No eBay seller data is ever stored; eBay listings inactive or unseen this long are deleted
RACK_EBAY_RETENTION_DAYS=7
# getItem lookups (size, brand, department) for new eBay listings, per eBay day and per run
RACK_EBAY_DETAILS_DAILY_CAP=1000
RACK_EBAY_DETAILS_BATCH=20
# Cached AVIF/WebP thumbnails for tiles: deleted after this many days, and kept under this size
RACK_THUMBS_MAX_AGE_DAYS=7
RACK_THUMBS_MAX_MB=1024

# --- Grailed (unofficial) ---
# grailed.com blocks Rack, so Rack queries the Algolia search index Grailed's own site uses, with the
# public search-only key that site ships to every browser. Currently: app MNRWEFSS2Q (see README).

# --- Source rate limits (seconds between requests) ---
RATE_EBAY=2
RATE_VINTED=10
RATE_GRAILED=10
# Listing thumbnails fetched from marketplace image CDNs, only to compute embeddings
RATE_IMAGES=0.25

# --- Embeddings ---
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
RACK_EMBED_IMAGES_PER_LISTING=1

# Worker
RACK_REFRESH_MINUTES=30
RACK_QUERIES_PER_REFRESH=12
# queries the Refresh button runs (smaller, so it finishes in about a minute)
RACK_MANUAL_QUERIES=6
RACK_SCORE_SECONDS=60
# "Refresh" button: minimum minutes between manual source searches
RACK_MANUAL_REFRESH_COOLDOWN_MINUTES=5
# Used only until you add designers or wishlist text
RACK_SEED_QUERIES=maison margiela,rick owens,our legacy
# Friends' accounts (v2.1; the owner has no caps): hunts per friend, minimum minutes between a
# friend's hunt runs, wardrobe items per friend that get Grailed sold-price checks, and how often
# a friend's feed is rescored when only listings changed (their own changes rescore at once)
RACK_FRIEND_MAX_HUNTS=5
RACK_FRIEND_MIN_HUNT_MINUTES=60
RACK_FRIEND_SOLD_ITEMS=30
RACK_FRIEND_RESCORE_MINUTES=10

# --- Optional LLM re-rank (app works fully without it) ---
LLM_ENABLED=false
LLM_MODEL=claude-opus-5-5
LLM_TOP_N=30
# Each call judges up to LLM_TOP_N listings (photos + details), roughly $0.10-0.20 per call on Opus.
# Listings are re-judged only after LLM_VERDICT_DAYS. LLM_WEIGHT: how far a verdict moves a score.
LLM_DAILY_CALL_CAP=12
LLM_VERDICT_DAYS=3
LLM_WEIGHT=0.3

# --- Notifications ---
# ntfy: install the ntfy app, subscribe to NTFY_TOPIC on NTFY_URL. Anyone who knows the topic can
# read it, so make it long and random:  python -c "import secrets;print('rack-'+secrets.token_urlsafe(24))"
# (ntfy.sh is a public server and sees alert text; self-host ntfy if that matters to you.)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# Telegram (optional): create a bot with @BotFather, message it once, then get your chat id from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Price-drop alerts for saved items: check every N hours; alert if the price falls by both amounts
RACK_PRICE_CHECK_HOURS=6
RACK_PRICE_DROP_MIN_PCT=5
RACK_PRICE_DROP_MIN_GBP=5
# Landed-cost estimate for imports (UK VAT is always 20%; duty/fee only above £135)
LANDED_DUTY_RATE=0.12
LANDED_HANDLING_FEE_GBP=12
# Web Push to the installed app (phone home screen / desktop): docker compose run --rm api rack vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Cloudflare Tunnel (docker compose --profile tunnel up) ---
# Cloudflare Tunnel (public HTTPS, no open ports): Zero Trust > Networks > Tunnels > create,
# copy the token here, add a public hostname pointing to http://api:8000, then
#   docker compose --profile tunnel up -d
# Put Cloudflare Access (email one-time code) in front of that hostname as a second lock.
# Where the app listens on this PC: 127.0.0.1 (default, this PC only) or 0.0.0.0 (your LAN)
RACK_BIND=127.0.0.1
RACK_PORT=8000
