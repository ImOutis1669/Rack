# Worker-only secrets. Copy to .env.worker.
# eBay: developer.ebay.com > Application Keys (production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Grailed: public search-only Algolia key that grailed.com ships to browsers (see README)
GRAILED_ALGOLIA_APP_ID=
GRAILED_ALGOLIA_API_KEY=
# Vestiaire via the paid Apify actor (optional)
APIFY_TOKEN=
# Optional Claude second opinion (LLM_ENABLED=true in .env)
ANTHROPIC_API_KEY=
